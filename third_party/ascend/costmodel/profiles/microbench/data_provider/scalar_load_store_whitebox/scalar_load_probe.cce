// White-box scalar-load calibration probes (CAModel).
// Scope: ONLY SIMD MainScalar GM load and SIMT warp-uniform GM load.
// Each oN kernel issues N loads to addresses inside the SAME 64B/128B line,
// which matches the npu_* scalar-load Stages (one scalar load per Stage).
// ABI is shared with scalar_bench_host.cpp: (out, gm, iters, mode).
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"

using DT = float;

extern "C" __global__ [aicore] void
simd_main_ld_o1(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0];
  out[0] = (long long)(a0);
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_ld_uniform_o1_core(__gm__ DT* gm, __ubuf__ DT* sink) {
  int lane = threadIdx.x;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0];
  sink[lane] = (DT)(a0);
}

extern "C" __global__ [aicore] void
simt_ld_uniform_o1(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  auto sink = reinterpret_cast<__ubuf__ DT*>(0);
  cce::async_invoke<simt_ld_uniform_o1_core>(cce::dim3{32, 1, 1}, gm, sink);
  out[0] = 0;
}

extern "C" __global__ [aicore] void
simd_main_ld_o2(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0];
  DT a1 = p[1];
  out[0] = (long long)(a0 + a1);
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_ld_uniform_o2_core(__gm__ DT* gm, __ubuf__ DT* sink) {
  int lane = threadIdx.x;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0];
  DT a1 = p[1];
  sink[lane] = (DT)(a0 + a1);
}

extern "C" __global__ [aicore] void
simt_ld_uniform_o2(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  auto sink = reinterpret_cast<__ubuf__ DT*>(0);
  cce::async_invoke<simt_ld_uniform_o2_core>(cce::dim3{32, 1, 1}, gm, sink);
  out[0] = 0;
}

extern "C" __global__ [aicore] void
simd_main_ld_o4(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0];
  DT a1 = p[1];
  DT a2 = p[2];
  DT a3 = p[3];
  out[0] = (long long)(a0 + a1 + a2 + a3);
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_ld_uniform_o4_core(__gm__ DT* gm, __ubuf__ DT* sink) {
  int lane = threadIdx.x;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0];
  DT a1 = p[1];
  DT a2 = p[2];
  DT a3 = p[3];
  sink[lane] = (DT)(a0 + a1 + a2 + a3);
}

extern "C" __global__ [aicore] void
simt_ld_uniform_o4(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  auto sink = reinterpret_cast<__ubuf__ DT*>(0);
  cce::async_invoke<simt_ld_uniform_o4_core>(cce::dim3{32, 1, 1}, gm, sink);
  out[0] = 0;
}

extern "C" __global__ [aicore] void
simd_main_ld_o8(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0];
  DT a1 = p[1];
  DT a2 = p[2];
  DT a3 = p[3];
  DT a4 = p[4];
  DT a5 = p[5];
  DT a6 = p[6];
  DT a7 = p[7];
  out[0] = (long long)(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7);
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_ld_uniform_o8_core(__gm__ DT* gm, __ubuf__ DT* sink) {
  int lane = threadIdx.x;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0];
  DT a1 = p[1];
  DT a2 = p[2];
  DT a3 = p[3];
  DT a4 = p[4];
  DT a5 = p[5];
  DT a6 = p[6];
  DT a7 = p[7];
  sink[lane] = (DT)(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7);
}

extern "C" __global__ [aicore] void
simt_ld_uniform_o8(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  auto sink = reinterpret_cast<__ubuf__ DT*>(0);
  cce::async_invoke<simt_ld_uniform_o8_core>(cce::dim3{32, 1, 1}, gm, sink);
  out[0] = 0;
}
