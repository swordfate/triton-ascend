simt_st_uniform_diff_o2_core(__gm__ DT* gm) {
  volatile __gm__ DT* p = gm;
  p[0 * 32] = 1.0f; p[1 * 32] = 1.0f;
}
extern "C" __global__ [aicore] void
simt_st_uniform_diff_o2(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
