simt_st_uniform_diff_o8_core(__gm__ DT* gm) {
  volatile __gm__ DT* p = gm;
  p[0 * 32] = 1.0f; p[1 * 32] = 1.0f; p[2 * 32] = 1.0f; p[3 * 32] = 1.0f; p[4 * 32] = 1.0f; p[5 * 32] = 1.0f; p[6 * 32] = 1.0f; p[7 * 32] = 1.0f;
