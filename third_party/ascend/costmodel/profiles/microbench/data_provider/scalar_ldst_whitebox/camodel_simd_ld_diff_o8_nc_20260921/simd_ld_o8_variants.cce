// SIMD scalar o8 load variants: with/without the final ADD reduction.
// Addresses: same-line p[0..7]; diff-line p[0*16..7*16] (64B apart).
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"
using DT = float;

extern "C" __global__ [aicore] void
simd_main_ld_same_o8_sum(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0]; DT a1 = p[1]; DT a2 = p[2]; DT a3 = p[3];
  DT a4 = p[4]; DT a5 = p[5]; DT a6 = p[6]; DT a7 = p[7];
  out[0] = (long long)(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7);
}

extern "C" __global__ [aicore] void
simd_main_ld_same_o8_nc(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  (void)p[0]; (void)p[1]; (void)p[2]; (void)p[3];
  (void)p[4]; (void)p[5]; (void)p[6]; (void)p[7];
  out[0] = 0;
}

extern "C" __global__ [aicore] void
simd_main_ld_diff_o8_sum(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0 * 16]; DT a1 = p[1 * 16]; DT a2 = p[2 * 16]; DT a3 = p[3 * 16];
  DT a4 = p[4 * 16]; DT a5 = p[5 * 16]; DT a6 = p[6 * 16]; DT a7 = p[7 * 16];
  out[0] = (long long)(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7);
}

extern "C" __global__ [aicore] void
simd_main_ld_diff_o8_nc(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  (void)p[0 * 16]; (void)p[1 * 16]; (void)p[2 * 16]; (void)p[3 * 16];
  (void)p[4 * 16]; (void)p[5 * 16]; (void)p[6 * 16]; (void)p[7 * 16];
  out[0] = 0;
}
