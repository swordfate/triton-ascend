// scalar_ldst_whitebox/store/scalar_o4 — real-board SYS_CNT probes.
// Same kernel bodies as store_scalar_o4.cce, wrapped with get_sys_cnt().
// ABI: (out, gm, iters, mode); each kernel writes the measured ticks to out[0].
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"

using DT = float;

extern "C" __global__ [aicore] void
simd_nop_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)gm; (void)iters; (void)mode;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
}

extern "C" __global__ [aicore] void
simd_main_st_same_o4_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  p[0] = (DT)1.0f; p[1] = (DT)2.0f; p[2] = (DT)3.0f; p[3] = (DT)4.0f;
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
}

extern "C" __global__ [aicore] void
simd_main_st_same_o4_dcci_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  p[0] = (DT)1.0f; p[1] = (DT)2.0f; p[2] = (DT)3.0f; p[3] = (DT)4.0f;
  dcci((__gm__ void*)p, 1);
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
}

extern "C" __global__ [aicore] void
simd_main_st_diff_o4_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  p[0 * 16] = (DT)1.0f; p[1 * 16] = (DT)2.0f; p[2 * 16] = (DT)3.0f; p[3 * 16] = (DT)4.0f;
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
}

extern "C" __global__ [aicore] void
simd_main_st_diff_o4_dcci_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  p[0 * 16] = (DT)1.0f; p[1 * 16] = (DT)2.0f; p[2 * 16] = (DT)3.0f; p[3 * 16] = (DT)4.0f;
  dcci((__gm__ void*)p, 1);
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_nop_core(__gm__ DT* gm, __ubuf__ DT* sink) {
  (void)gm;
  int lane = threadIdx.x;
  sink[lane] = (DT)(lane + 100);
}
extern "C" __global__ [aicore] void
simt_nop_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  auto sink = reinterpret_cast<__ubuf__ DT*>(0);
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  cce::async_invoke<simt_nop_core>(cce::dim3{32, 1, 1}, gm, sink);
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
}

__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_st_uniform_same_o4_core(__gm__ DT* gm) {
  gm[0] = (DT)1.0f; gm[1] = (DT)2.0f; gm[2] = (DT)3.0f; gm[3] = (DT)4.0f;
}
extern "C" __global__ [aicore] void
simt_st_uniform_same_o4_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  cce::async_invoke<simt_st_uniform_same_o4_core>(cce::dim3{32, 1, 1}, gm);
  pipe_barrier(PIPE_ALL);
  long long t1 = get_sys_cnt();
  out[0] = t1 - t0;
}

extern "C" __global__ [aicore] void
simt_st_uniform_same_o4_dcci_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  pipe_barrier(PIPE_ALL);
