__simt_vf__ LAUNCH_BOUND(32) __aiv__ __attribute__((always_inline)) static void
simt_st_uniform_diff_o4_core(__gm__ DT* gm) {
  gm[0 * 32] = (DT)1.0f; gm[1 * 32] = (DT)2.0f; gm[2 * 32] = (DT)3.0f; gm[3 * 32] = (DT)4.0f;
}
extern "C" __global__ [aicore] void
simt_st_uniform_diff_o4_syscnt(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
