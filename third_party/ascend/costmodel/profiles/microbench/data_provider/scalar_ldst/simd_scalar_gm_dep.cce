// SIMD/MainScalar scalar GM dependent-load probe for dav-c310.
//
// mode 0: independent scalar GM loads (baseline)
// mode 1: dependent scalar GM load chain (address depends on previous load)
//
// The host prints cycles per inner iteration and the implied extra cycles per
// dependency edge: (dependent - independent) / ops.
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"

using DT = float;

extern "C" __global__ [aicore] void measure(__gm__ long long *out,
                                             __gm__ DT *gm, int K, int iters,
                                             int mode, int ops) {
  if (ops < 1)
    ops = 1;
  if (ops > 8)
    ops = 8;

  DT acc = (DT)1;
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  for (int k = 0; k < K; ++k) {
    for (int i = 0; i < iters; ++i) {
      int base = (i & 4095) * ops;
      if (mode == 0) {
        // Independent loads: addresses do not depend on loaded data.
        if (ops == 1) {
          acc += gm[base];
        } else if (ops == 2) {
          acc += gm[base];
          acc += gm[base + 1];
        } else if (ops == 4) {
          acc += gm[base];
          acc += gm[base + 1];
          acc += gm[base + 2];
          acc += gm[base + 3];
        } else {
          acc += gm[base];
          acc += gm[base + 1];
          acc += gm[base + 2];
          acc += gm[base + 3];
          acc += gm[base + 4];
          acc += gm[base + 5];
          acc += gm[base + 6];
          acc += gm[base + 7];
        }
      } else {
        // Dependent load chain through a pre-filled linked list.
        auto igm = reinterpret_cast<__gm__ int *>(gm);
        int cur = 0;
        for (int j = 0; j < ops; ++j) {
          cur = igm[cur & 4095];
          acc += (DT)cur;
        }
      }
    }
    pipe_barrier(PIPE_ALL);
  }
  long long t1 = get_sys_cnt();
  pipe_barrier(PIPE_ALL);
  out[0] = t1 - t0;
  // Keep acc alive after the timed region so loads are not optimized.
  gm[0] = acc;
}
