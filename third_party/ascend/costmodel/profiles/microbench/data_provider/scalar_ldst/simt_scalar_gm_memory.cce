// Dedicated SIMT uniform-scalar GM load/store probe for dav-c310.
//
// mode 0: per-warp uniform loads.  All lanes in a warp read the same address;
//         each warp reads a different address. OPS is compile-time unrolled.
// mode 1: per-warp uniform stores.
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"

using DT = float;

template <typename T, int OPS>
__simt_vf__ LAUNCH_BOUND(1024) __aiv__ __attribute__((always_inline)) static void
simt_uniform_core(__gm__ T *gm, __ubuf__ T *sink, int nlane, int nwarp,
                  int iters, int mode) {
  int lane = threadIdx.x;
  int warp = threadIdx.y;
  if (lane >= nlane || warp >= nwarp)
    return;

  T acc = (T)(warp + 1);
  for (int i = 0; i < iters; ++i) {
    int base = (i & 4095) * (nwarp * OPS) + warp * OPS;
    if (mode == 0) {
      if (OPS >= 1) acc += gm[base + 0];
      if (OPS >= 2) acc += gm[base + 1];
      if (OPS >= 4) { acc += gm[base + 2]; acc += gm[base + 3]; }
      if (OPS >= 8) {
        acc += gm[base + 4]; acc += gm[base + 5];
        acc += gm[base + 6]; acc += gm[base + 7];
      }
      if (OPS >= 16) {
        acc += gm[base + 8];  acc += gm[base + 9];
        acc += gm[base + 10]; acc += gm[base + 11];
        acc += gm[base + 12]; acc += gm[base + 13];
        acc += gm[base + 14]; acc += gm[base + 15];
      }
      if (OPS >= 32) {
        acc += gm[base + 16]; acc += gm[base + 17];
        acc += gm[base + 18]; acc += gm[base + 19];
        acc += gm[base + 20]; acc += gm[base + 21];
        acc += gm[base + 22]; acc += gm[base + 23];
        acc += gm[base + 24]; acc += gm[base + 25];
        acc += gm[base + 26]; acc += gm[base + 27];
        acc += gm[base + 28]; acc += gm[base + 29];
        acc += gm[base + 30]; acc += gm[base + 31];
      }
    } else {
      if (OPS >= 1) gm[base + 0] = acc;
      if (OPS >= 2) gm[base + 1] = acc + (T)1;
      if (OPS >= 4) { gm[base + 2] = acc + (T)2; gm[base + 3] = acc + (T)3; }
      if (OPS >= 8) {
        gm[base + 4] = acc + (T)4; gm[base + 5] = acc + (T)5;
        gm[base + 6] = acc + (T)6; gm[base + 7] = acc + (T)7;
      }
      if (OPS >= 16) {
        gm[base + 8] = acc + (T)8;  gm[base + 9] = acc + (T)9;
        gm[base + 10] = acc + (T)10; gm[base + 11] = acc + (T)11;
        gm[base + 12] = acc + (T)12; gm[base + 13] = acc + (T)13;
        gm[base + 14] = acc + (T)14; gm[base + 15] = acc + (T)15;
      }
      if (OPS >= 32) {
        gm[base + 16] = acc + (T)16; gm[base + 17] = acc + (T)17;
        gm[base + 18] = acc + (T)18; gm[base + 19] = acc + (T)19;
        gm[base + 20] = acc + (T)20; gm[base + 21] = acc + (T)21;
        gm[base + 22] = acc + (T)22; gm[base + 23] = acc + (T)23;
        gm[base + 24] = acc + (T)24; gm[base + 25] = acc + (T)25;
        gm[base + 26] = acc + (T)26; gm[base + 27] = acc + (T)27;
        gm[base + 28] = acc + (T)28; gm[base + 29] = acc + (T)29;
        gm[base + 30] = acc + (T)30; gm[base + 31] = acc + (T)31;
      }
      acc += (T)1;
    }
  }
  sink[warp * 32 + lane] = acc;
}

extern "C" __global__ [aicore] void measure(__gm__ long long *out,
                                             __gm__ DT *gm, int K, int nlane,
                                             int nwarp, int iters, int mode,
                                             int ops) {
  auto sink = reinterpret_cast<__ubuf__ DT *>(0);
  pipe_barrier(PIPE_ALL);
  long long t0 = get_sys_cnt();
  for (int i = 0; i < K; ++i) {
    if (ops == 1) {
      cce::async_invoke<simt_uniform_core<DT, 1>>(
          cce::dim3{32, (unsigned)nwarp, 1}, gm, sink, nlane, nwarp, iters, mode);
    } else if (ops == 2) {
      cce::async_invoke<simt_uniform_core<DT, 2>>(
          cce::dim3{32, (unsigned)nwarp, 1}, gm, sink, nlane, nwarp, iters, mode);
    } else if (ops == 4) {
      cce::async_invoke<simt_uniform_core<DT, 4>>(
          cce::dim3{32, (unsigned)nwarp, 1}, gm, sink, nlane, nwarp, iters, mode);
    } else if (ops == 8) {
      cce::async_invoke<simt_uniform_core<DT, 8>>(
          cce::dim3{32, (unsigned)nwarp, 1}, gm, sink, nlane, nwarp, iters, mode);
    } else if (ops == 16) {
      cce::async_invoke<simt_uniform_core<DT, 16>>(
          cce::dim3{32, (unsigned)nwarp, 1}, gm, sink, nlane, nwarp, iters, mode);
    } else {
      cce::async_invoke<simt_uniform_core<DT, 32>>(
          cce::dim3{32, (unsigned)nwarp, 1}, gm, sink, nlane, nwarp, iters, mode);
    }
    pipe_barrier(PIPE_ALL);
  }
  long long t1 = get_sys_cnt();
  pipe_barrier(PIPE_ALL);
  out[0] = t1 - t0;
}
