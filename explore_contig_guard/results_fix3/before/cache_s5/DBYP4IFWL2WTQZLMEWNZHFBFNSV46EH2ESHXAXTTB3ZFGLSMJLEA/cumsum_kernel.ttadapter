module attributes {hacc.target = #hacc.target<"Ascend950PR_9579">} {
  tt.func public @cumsum_kernel(%arg0: !tt.ptr<i32> {tt.divisibility = 16 : i32}, %arg1: !tt.ptr<i32> {tt.divisibility = 16 : i32}, %arg2: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %c128_i32 = arith.constant 128 : i32
    %0 = tt.get_program_id x : i32
    %1 = tt.get_num_programs x : i32
    %2 = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
    scf.for %arg3 = %0 to %arg2 step %1  : i32 {
      %3 = arith.muli %arg3, %c128_i32 : i32
      %4 = tt.addptr %arg0, %3 : !tt.ptr<i32>, i32
      %5 = tt.splat %4 : !tt.ptr<i32> -> tensor<128x!tt.ptr<i32>>
      %6 = tt.addptr %5, %2 : tensor<128x!tt.ptr<i32>>, tensor<128xi32>
      %7 = tt.load %6 : tensor<128x!tt.ptr<i32>>
      %8 = "tt.scan"(%7) <{axis = 0 : i32, reverse = true}> ({
      ^bb0(%arg4: i32, %arg5: i32):
        %12 = arith.addi %arg4, %arg5 : i32
        tt.scan.return %12 : i32
      }) : (tensor<128xi32>) -> tensor<128xi32>
      %9 = tt.addptr %arg1, %3 : !tt.ptr<i32>, i32
      %10 = tt.splat %9 : !tt.ptr<i32> -> tensor<128x!tt.ptr<i32>>
      %11 = tt.addptr %10, %2 : tensor<128x!tt.ptr<i32>>, tensor<128xi32>
      tt.store %11, %8 : tensor<128x!tt.ptr<i32>>
    }
    tt.return
  }
}
