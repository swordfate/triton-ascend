// SIMD MainScalar diff-line o8 scheduling variants.
// Same 8 addresses: p[0*16]..p[7*16] (64B apart, 8 distinct lines).
#include "RegBase/VecUtils.h"
#include "Vector/VecUtils.h"
#include "Utils.h"
using DT = float;

// Control: loads through a volatile pointer (original probe style).
extern "C" __global__ [aicore] void
simd_main_ld_diff_o8_v(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  volatile __gm__ DT* p = gm;
  DT a0 = p[0 * 16]; DT a1 = p[1 * 16]; DT a2 = p[2 * 16]; DT a3 = p[3 * 16];
  DT a4 = p[4 * 16]; DT a5 = p[5 * 16]; DT a6 = p[6 * 16]; DT a7 = p[7 * 16];
  out[0] = (long long)(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7);
}

// Non-volatile loads: compiler is free to schedule all 8 loads independently.
extern "C" __global__ [aicore] void
simd_main_ld_diff_o8_nv(__gm__ long long* out, __gm__ DT* gm, int iters, int mode) {
  (void)iters; (void)mode;
  __gm__ DT* p = gm;
  DT a0 = p[0 * 16]; DT a1 = p[1 * 16]; DT a2 = p[2 * 16]; DT a3 = p[3 * 16];
  DT a4 = p[4 * 16]; DT a5 = p[5 * 16]; DT a6 = p[6 * 16]; DT a7 = p[7 * 16];
  out[0] = (long long)(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7);
}
